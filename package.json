{
  "name": "ox0-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "node --test",
    "validate": "npm run validate:legacy && npm run validate:articles",
    "validate:legacy": "node scripts/validate-post.mjs",
    "validate:articles": "node scripts/validate-articles.mjs",
    "dry-run": "node scripts/plan-article.mjs",
    "dry-run:article": "node scripts/plan-article.mjs",
    "dry-run:legacy": "node scripts/plan-post.mjs",
    "sync:article": "node scripts/sync-article.mjs",
    "verify:article-live-draft": "node scripts/verify-article-live-draft.mjs",
    "verify:ghost-live:legacy": "node scripts/verify-ghost-live.mjs && node scripts/verify-body-image-live.mjs"
  },
  "dependencies": {
    "marked": "18.0.11"
  }
}
